# Spotify API credentials
# https://developer.spotify.com/dashboard -> Your App
# Redirect URI: http://127.0.0.1:19823/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# SoundCloud API credentials
# SoundCloud Developer Portal -> Your App
# Redirect URI: http://127.0.0.1:19823/callback
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# DAB Music API credentials (dabmusic.xyz)
# Register at https://dabmusic.xyz/register
# Used for FLAC downloads — primary source before YouTube fallback
DAB_EMAIL=
DAB_PASSWORD=

# AcoustID API credentials
# Register at https://acoustid.org/new-application to get an API key
# Used for MusicBrainz recording ID lookup from audio fingerprints
ACOUSTID_API_KEY=
