{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicLibraryManager",
  "version": "0.1.0",
  "identifier": "com.musiclibrary.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd ../ui && bun run dev",
    "beforeBuildCommand": "cd ../ui && bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Music Library Manager",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "maximizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["musiclibrary"]
      }
    }
  }
}
